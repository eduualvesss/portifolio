diff --git a/src/hooks/useReveal.js b/src/hooks/useReveal.js
new file mode 100644
index 0000000..dbf2d05
--- /dev/null
+++ b/src/hooks/useReveal.js
@@ -0,0 +1,31 @@
+import { useEffect, useRef, useState } from "react";
+
+const prefersReducedMotion =
+  typeof window !== "undefined" && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+
+// One motion vocabulary, reused everywhere: rise + fade + light
+// blur-in, once, on scroll into view. No hover-triggered variant.
+export function useReveal() {
+  const ref = useRef(null);
+  const [visible, setVisible] = useState(prefersReducedMotion);
+
+  useEffect(() => {
+    if (prefersReducedMotion || !ref.current) return undefined;
+
+    const node = ref.current;
+    const observer = new IntersectionObserver(
+      ([entry]) => {
+        if (entry.isIntersecting) {
+          setVisible(true);
+          observer.unobserve(node);
+        }
+      },
+      { threshold: 0.15 },
+    );
+
+    observer.observe(node);
+    return () => observer.disconnect();
+  }, []);
+
+  return [ref, visible];
+}
