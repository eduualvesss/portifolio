# Set these as Environment Variables in your Vercel project settings
# (Project -> Settings -> Environment Variables), not in a committed file.
# This file is a reference only; copy it to .env for local `vercel dev` use.

# Your GitHub username. Everything the API serves is derived from this account.
GITHUB_USERNAME=eduualvesss

# Optional. A GitHub personal access token (no scopes needed for public data)
# raises GitHub's API rate limit from 60 to 5000 requests/hour.
# Create one at https://github.com/settings/tokens
GITHUB_TOKEN=

# How long fetched GitHub data is cached, in seconds.
CACHE_TTL_SECONDS=600
